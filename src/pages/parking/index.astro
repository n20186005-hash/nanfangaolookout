---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import { parkingFaqs } from '../../data/faqs';
import { ATTRACTION, SITE_URL, withSiteName } from '../../data/site';
import { buildFaq } from '../../lib/schema';

const title = withSiteName('南方澳觀景台停車與交通：免費停車、安全迴轉、公車怎麼搭');
const description =
  '南方澳觀景台停車指南：台9丁線自駕路線、路旁免費停車空間與車位狀況、彎道安全迴轉提醒，以及搭乘客運、台鐵再轉乘的上山方式。';

const routeSteps = [
  { icon: 'car', title: '蘇澳市區出發', text: '由蘇澳市區往舊蘇花公路方向，導航請確認是台9丁線而非其他替代道路。' },
  { icon: 'mountain', title: '台9丁線約 5.5 公里處', text: '山路彎道多，請放慢車速、避免彎道超車，並留意對向來車與機車。' },
  { icon: 'parking', title: '路旁免費停車空間', text: '車位有限且部分緊鄰彎道，停妥後步行約 1 分鐘即可抵達觀景平台。' },
] as const;

const parkingNotes = [
  { icon: 'parking', title: '免費但數量有限', text: '日出、假日與傍晚最容易停滿，熱門時段請預備替代行程。' },
  { icon: 'arrow', title: '安全迴轉優先', text: '若車位在對向，往前到視線良好、合法安全處再迴轉，不要跨越雙黃線。' },
  { icon: 'info', title: '勿在彎道臨停', text: '彎道突然減速或路邊臨停下車風險高，也容易影響後方車流。' },
  { icon: 'ship', title: '大型車請先評估', text: '路旁空間以小型車為主，大型車與露營車建議改以接駁方式前往。' },
] as const;

const transitOptions = [
  { icon: 'route', title: '客運', text: '先搭乘客運到蘇澳或南方澳一帶，再轉乘計程車或接駁上山；班次請以客運業者公告為準。' },
  { icon: 'mountain', title: '台鐵', text: '搭火車至蘇澳一帶車站後轉乘計程車，是沒有自駕時最穩定的做法。' },
  { icon: 'walk', title: '步行與自行車', text: '台9丁線為山路彎道，路肩有限，不建議以步行或自行車作為主要上山方式。' },
] as const;

const crumbs = [
  { name: '首頁', url: SITE_URL },
  { name: '停車與交通', url: `${SITE_URL}parking/` },
];
---

<SubpageLayout
  title={title}
  description={description}
  kicker="停車・自駕・大眾運輸"
  heading="南方澳觀景台怎麼停車？交通路線一次看懂"
  intro="觀景台沒有專屬大型停車場，主要仰賴台9丁線路旁的免費停車空間。把安全迴轉放在搶車位之前，會讓整趟行程順很多。"
  current="/parking/"
  crumbs={crumbs}
  structuredData={[buildFaq(parkingFaqs)]}
>
  <section class="py-16 sm:py-20">
    <div class="container-site">
      <div class="reveal max-w-3xl">
        <p class="section-kicker text-xs font-semibold text-dawn-600">自駕路線</p>
        <h2 class="mt-4 text-balance text-3xl font-semibold tracking-[-0.03em] text-ocean-950 sm:text-4xl">三個路段，就能抵達觀景台。</h2>
        <p class="mt-5 leading-8 text-ocean-800/72">路程不長，但彎道多。請把導航預估時間再加上緩衝，天候不佳時更要放慢車速。</p>
      </div>

      <ol class="reveal mt-10 grid gap-4 lg:grid-cols-3">
        {routeSteps.map((step, index) => (
          <li class="rounded-[1.7rem] border border-ocean-100 bg-white p-6">
            <div class="flex items-center justify-between">
              <span class="grid size-11 place-items-center rounded-full bg-ocean-50 text-ocean-700"><Icon name={step.icon} class="size-5" /></span>
              <span class="text-sm font-semibold text-ocean-700/50">步驟 {index + 1}</span>
            </div>
            <h3 class="mt-5 text-xl font-semibold text-ocean-950">{step.title}</h3>
            <p class="mt-2 text-sm leading-7 text-ocean-800/70">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-ocean-50 py-16 sm:py-20">
    <div class="container-site">
      <div class="reveal grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <div>
          <p class="section-kicker text-xs font-semibold text-dawn-600">停車重點</p>
          <h2 class="mt-4 text-balance text-3xl font-semibold tracking-[-0.03em] text-ocean-950 sm:text-4xl">車位有限，安全比速度重要。</h2>
        </div>
        <p class="max-w-2xl leading-8 text-ocean-800/72 lg:justify-self-end">
          觀景台的停車空間是路旁免費停放，沒有劃設完整停車場。熱門時段容易停滿，請先想好替代動線。
        </p>
      </div>

      <div class="reveal mt-10 grid gap-4 sm:grid-cols-2">
        {parkingNotes.map((note) => (
          <article class="flex gap-4 rounded-[1.7rem] border border-ocean-100 bg-white p-6">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-ocean-50 text-ocean-700"><Icon name={note.icon} class="size-5" /></span>
            <div>
              <h3 class="font-semibold text-ocean-950">{note.title}</h3>
              <p class="mt-2 text-sm leading-7 text-ocean-800/70">{note.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-site grid gap-10 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="reveal">
        <p class="section-kicker text-xs font-semibold text-dawn-600">沒有開車</p>
        <h2 class="mt-4 text-balance text-3xl font-semibold tracking-[-0.03em] text-ocean-950 sm:text-4xl">搭大眾運輸怎麼上山最實際？</h2>
        <p class="mt-5 leading-8 text-ocean-800/72">
          觀景台門口沒有客運站牌，最常見的做法是先在蘇澳或南方澳一帶下車，再轉乘計程車或接駁上山。班次與路線會隨業者調整，請以官方時刻為準。
        </p>
        <div class="mt-8 space-y-4">
          {transitOptions.map((option) => (
            <div class="flex gap-4 rounded-2xl border border-ocean-100 bg-white p-5">
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-ocean-50 text-ocean-700"><Icon name={option.icon} class="size-5" /></span>
              <div>
                <h3 class="font-semibold text-ocean-950">{option.title}</h3>
                <p class="mt-1.5 text-sm leading-7 text-ocean-800/70">{option.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="reveal overflow-hidden rounded-[2rem] border border-ocean-100 bg-white">
        <div class="border-b border-ocean-100 p-7 sm:p-9">
          <p class="text-sm font-semibold text-dawn-700">地圖位置</p>
          <h3 class="mt-2 text-2xl font-semibold text-ocean-950">南方澳觀景台</h3>
          <p class="mt-2 text-sm leading-6 text-ocean-800/65">
            {ATTRACTION.addressFull}・Plus Code {ATTRACTION.plusCode}
          </p>
          <a
            href={ATTRACTION.navigationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-ocean-950 px-5 py-3 font-semibold text-white transition hover:bg-ocean-800"
          >
            <Icon name="map" class="size-4" />
            使用目前位置導航
          </a>
          <p class="mt-3 text-xs text-ocean-700/55">座標：{ATTRACTION.coordinateText}</p>
        </div>
        <div class="aspect-[4/3] w-full sm:aspect-[16/9]">
          <iframe
            src={ATTRACTION.embedUrl}
            title="南方澳觀景台 Google 地圖"
            width="600"
            height="450"
            class="size-full"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <FAQ
    items={parkingFaqs}
    kicker="停車與交通 FAQ"
    title="關於停車，最常被問的六件事。"
    description="沒有大型停車場，也沒有收費亭。先把車位與迴轉動線想清楚，就能少走冤枉路。"
    linkHref="/nearby/"
    linkLabel="接著看周邊順遊"
  />
</SubpageLayout>
