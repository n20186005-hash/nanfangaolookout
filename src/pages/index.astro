---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StatusBar from '../components/StatusBar.astro';
import QuickFacts from '../components/QuickFacts.astro';
import PanoramaExplorer from '../components/PanoramaExplorer.astro';
import BestTime from '../components/BestTime.astro';
import Transport from '../components/Transport.astro';
import ItineraryPlanner from '../components/ItineraryPlanner.astro';
import Gallery from '../components/Gallery.astro';
import Explore from '../components/Explore.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import MobileActions from '../components/MobileActions.astro';
import { faqs } from '../data/faqs';
import { buildAttraction, buildFaq, buildWebSite } from '../lib/schema';

const title = '南方澳觀景台正常開放中｜免門票、停車交通、日出夜景與宜蘭蘇澳順遊攻略';
const description =
  '南方澳觀景台免門票、全時段開放，Google 評價 4.5。整理台9丁線自駕路線、免費停車與安全迴轉、日出與夜景最佳時段，並串連內埤海灣、豆腐岬與南方澳漁港美食行程。';

const structuredData = [buildAttraction(), buildFaq(faqs), buildWebSite()];
---
<BaseLayout title={title} description={description} structuredData={structuredData}>
  <Header />
  <main>
    <Hero />
    <StatusBar />
    <QuickFacts />
    <PanoramaExplorer />
    <BestTime />
    <Transport />
    <ItineraryPlanner />
    <Gallery />
    <Explore />
    <FAQ />
  </main>
  <Footer />
  <MobileActions />
</BaseLayout>
