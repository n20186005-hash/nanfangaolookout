---
import Icon from './Icon.astro';
---
<section id="top" class="relative min-h-[760px] overflow-hidden bg-ocean-950 text-white md:min-h-[820px]">
  <picture class="absolute inset-0">
    <source srcset="/images/neipi-1440.avif" type="image/avif" />
    <source srcset="/images/neipi-960.webp 960w, /images/neipi-1440.webp 1440w, /images/neipi-1920.webp 1920w" type="image/webp" />
    <img
      src="/images/neipi-1920.webp"
      alt="從南方澳觀景台俯瞰內埤漁港、內埤海灣與太平洋"
      class="h-full w-full object-cover object-[58%_center]"
      width="1920"
      height="1280"
      fetchpriority="high"
    />
  </picture>
  <div class="hero-shade absolute inset-0"></div>
  <div class="absolute inset-x-0 bottom-0 h-36 bg-gradient-to-t from-ocean-950/70 to-transparent"></div>

  <div class="container-site relative flex min-h-[760px] items-end pb-14 pt-32 md:min-h-[820px] md:items-center md:pb-24 md:pt-36">
    <div class="max-w-3xl">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-ocean-950/45 px-4 py-2 text-sm text-white/88 backdrop-blur-md">
        <span class="size-2 rounded-full bg-dawn-400 shadow-[0_0_0_5px_rgba(249,156,61,0.18)]"></span>
        宜蘭・蘇澳・台9丁線 5.5 公里處
      </div>
      <p class="section-kicker mb-4 text-xs font-semibold text-dawn-300">山海之間的漁港風景</p>
      <h1 class="text-balance text-5xl font-semibold leading-[1.05] tracking-[-0.04em] sm:text-6xl md:text-7xl">
        從山腰之上，<br />看見整座南方澳。
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-8 text-white/76 sm:text-lg">
        在約 140 公尺高的露天平台，俯瞰漁港、內埤海灣、筆架山與太平洋。從晨曦到港灣燈火，每個時段都有不同的海岸表情。
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#transport" class="inline-flex items-center gap-2 rounded-full bg-dawn-500 px-6 py-3.5 font-semibold text-white transition hover:bg-dawn-600">
          <Icon name="car" class="size-5" />
          查看停車方式
        </a>
        <a href="#best-time" class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-6 py-3.5 font-semibold text-white backdrop-blur-md transition hover:bg-white/16">
          <Icon name="sun" class="size-5" />
          今日觀景時間
        </a>
      </div>

      <div class="mt-10 grid max-w-2xl grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="glass-panel rounded-2xl p-4">
          <Icon name="ticket" class="mb-3 size-5 text-dawn-300" />
          <p class="text-sm text-white/56">門票</p>
          <p class="mt-1 font-semibold">免費參觀</p>
        </div>
        <div class="glass-panel rounded-2xl p-4">
          <Icon name="clock" class="mb-3 size-5 text-dawn-300" />
          <p class="text-sm text-white/56">開放</p>
          <p class="mt-1 font-semibold">全天開放</p>
        </div>
        <div class="glass-panel rounded-2xl p-4">
          <Icon name="mountain" class="mb-3 size-5 text-dawn-300" />
          <p class="text-sm text-white/56">海拔</p>
          <p class="mt-1 font-semibold">約 140 公尺</p>
        </div>
        <div class="glass-panel rounded-2xl p-4">
          <Icon name="camera" class="mb-3 size-5 text-dawn-300" />
          <p class="text-sm text-white/56">建議停留</p>
          <p class="mt-1 font-semibold">20–40 分鐘</p>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 right-6 hidden items-center gap-2 rounded-full bg-ocean-950/55 px-3 py-2 text-xs text-white/62 backdrop-blur md:flex">
    <span>實景照片</span><span class="h-3 w-px bg-white/25"></span><span>內埤漁港與海灣</span>
  </div>
</section>
