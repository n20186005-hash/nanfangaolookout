---
import Icon from './Icon.astro';
import { ATTRACTION, BRAND_NAME, PAGES } from '../data/site';

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === '/';
const anchorBase = isHome ? '' : '/';
---
<footer class="bg-ocean-950 pb-24 pt-14 text-white sm:pb-10">
  <div class="container-site">
    <div class="grid gap-10 border-b border-white/10 pb-10 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <span class="grid size-12 place-items-center rounded-full border border-white/15 bg-white/10 text-dawn-300"><Icon name="waves" class="size-6" /></span>
        <p class="mt-5 text-2xl font-semibold">{BRAND_NAME}</p>
        <p class="mt-2 max-w-xl text-sm leading-7 text-white/54">一份以真實景色、交通安全與出發前決策為核心的南方澳觀景指南。</p>
        <a
          href={ATTRACTION.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/8 px-3.5 py-2 text-xs text-white/70 transition hover:text-white"
        >
          <span class="text-dawn-300">★</span>
          Google {ATTRACTION.ratingValue}／{ATTRACTION.ratingCount.toLocaleString('en-US')} 則評價
          <Icon name="external" class="size-3.5 opacity-60" />
        </a>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-white/58" aria-label="頁尾導覽">
        <a href={`${anchorBase}#highlights`} class="hover:text-white">景觀亮點</a>
        <a href={`${anchorBase}#best-time`} class="hover:text-white">最佳時間</a>
        <a href={`${anchorBase}#transport`} class="hover:text-white">交通停車</a>
        <a href={`${anchorBase}#itinerary`} class="hover:text-white">順遊行程</a>
        <a href={`${anchorBase}#faq`} class="hover:text-white">常見問題</a>
        <a href="/credits/" class="hover:text-white">圖片授權</a>
        <a href="/privacy/" class="hover:text-white">隱私說明</a>
      </nav>
    </div>

    <div class="grid gap-4 border-b border-white/10 py-8 sm:grid-cols-2 lg:grid-cols-4">
      {PAGES.map((page) => (
        <a href={page.path} class="group rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-sm text-white/62 transition hover:border-white/20 hover:text-white">
          <span class="flex items-center justify-between gap-3 font-semibold text-white/86">
            {page.label}
            <Icon name="arrow" class="size-4 text-dawn-300" />
          </span>
        </a>
      ))}
    </div>

    <div class="flex flex-col gap-3 pt-6 text-xs text-white/42 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} NanfangaoLookout.com</p>
      <p>景點資訊最後查核：{ATTRACTION.lastChecked}；出發前仍請留意現場公告與天候。</p>
    </div>
  </div>
</footer>
