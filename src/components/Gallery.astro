---
import Icon from './Icon.astro';

const photos = [
  {
    src: '/images/hero-1440.webp',
    large: '/images/hero-1920.webp',
    alt: '由高處俯瞰南方澳港區、聚落與太平洋',
    title: '山海環抱的南方澳',
    note: '高處視角能同時看見港池、聚落與外海。',
    className: 'sm:col-span-2 sm:row-span-2',
  },
  {
    src: '/images/deck-960.webp',
    large: '/images/deck-1920.webp',
    alt: '南方澳觀景台的露天觀景平台與欄杆',
    title: '露天觀景平台',
    note: '停車後短距離即可抵達，現場遮蔭有限。',
    className: '',
  },
  {
    src: '/images/dusk-960.webp',
    large: '/images/dusk-1920.webp',
    alt: '黃昏光線下的南方澳港灣與山勢',
    title: '黃昏港灣',
    note: '日落後可繼續等待藍調與港區燈火。',
    className: '',
  },
  {
    src: '/images/neipi-960.webp',
    large: '/images/neipi-1920.webp',
    alt: '內埤漁港、海灣與筆架山方向',
    title: '內埤漁港與海灣',
    note: '狹長港池與弧形海岸是最具代表性的畫面。',
    className: '',
  },
  {
    src: '/images/coastline-960.webp',
    large: '/images/coastline-1920.webp',
    alt: '南方澳海岸線、山岬與漁港全景',
    title: '海岸與山岬',
    note: '晴朗時能看清海岸地形與外海層次。',
    className: '',
  },
];
---
<section id="gallery" class="py-20 sm:py-28">
  <div class="container-site">
    <div class="reveal flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="section-kicker text-xs font-semibold text-dawn-600">真實景色・實地視角</p>
        <h2 class="mt-4 text-balance text-4xl font-semibold tracking-[-0.03em] text-ocean-950 sm:text-5xl">先看實景，再決定今天是否值得上山。</h2>
      </div>
      <p class="max-w-md text-sm leading-7 text-ocean-800/62">照片均為南方澳及觀景台相關實景，點選即可放大。授權與攝影者資訊集中列於本站圖片授權頁。</p>
    </div>

    <div class="reveal mt-10 grid auto-rows-[240px] gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {photos.map((photo, index) => (
        <button
          type="button"
          class:list={['gallery-button group relative overflow-hidden rounded-[1.7rem] bg-ocean-950 text-left', photo.className]}
          data-index={index}
          aria-label={`放大查看：${photo.title}`}
        >
          <img src={photo.src} alt={photo.alt} class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.035]" width="1440" height="960" loading="lazy" />
          <span class="absolute inset-0 bg-gradient-to-t from-ocean-950/88 via-transparent to-transparent"></span>
          <span class="absolute inset-x-0 bottom-0 block p-5 text-white sm:p-6">
            <span class="block font-semibold">{photo.title}</span>
            <span class="mt-1 block text-xs leading-5 text-white/60">{photo.note}</span>
          </span>
          <span class="absolute right-4 top-4 grid size-10 place-items-center rounded-full border border-white/20 bg-ocean-950/45 text-white backdrop-blur transition group-hover:bg-ocean-950/70">
            <Icon name="camera" class="size-4" />
          </span>
        </button>
      ))}
    </div>
  </div>

  <dialog id="gallery-dialog" class="m-auto w-[min(94vw,1100px)] max-w-none overflow-hidden rounded-[1.5rem] border-0 bg-ocean-950 p-0 text-white shadow-2xl backdrop:bg-ocean-950/82">
    <div class="relative">
      <button id="gallery-close" type="button" class="absolute right-4 top-4 z-10 grid size-11 place-items-center rounded-full border border-white/20 bg-ocean-950/65 text-white backdrop-blur" aria-label="關閉照片">
        <Icon name="close" class="size-5" />
      </button>
      <img id="gallery-image" src="/images/hero-1920.webp" alt="" class="max-h-[78vh] w-full bg-ocean-950 object-contain" width="1920" height="1280" />
      <div class="p-5 sm:p-7">
        <h3 id="gallery-title" class="text-xl font-semibold"></h3>
        <p id="gallery-note" class="mt-2 text-sm leading-6 text-white/62"></p>
      </div>
    </div>
  </dialog>

  <script define:vars={{ photos }}>
    const galleryButtons = document.querySelectorAll('.gallery-button');
    const galleryDialog = document.getElementById('gallery-dialog');
    const galleryImage = document.getElementById('gallery-image');
    const galleryTitle = document.getElementById('gallery-title');
    const galleryNote = document.getElementById('gallery-note');
    const galleryClose = document.getElementById('gallery-close');

    galleryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const index = Number(button.dataset.index);
        const photo = photos[index];
        if (!photo || !galleryDialog || !galleryImage || !galleryTitle || !galleryNote) return;
        galleryImage.src = photo.large;
        galleryImage.alt = photo.alt;
        galleryTitle.textContent = photo.title;
        galleryNote.textContent = photo.note;
        galleryDialog.showModal();
      });
    });

    galleryClose?.addEventListener('click', () => galleryDialog?.close());
    galleryDialog?.addEventListener('click', (event) => {
      if (event.target === galleryDialog) galleryDialog.close();
    });
  </script>
</section>
