---
import Icon from './Icon.astro';
---
<div class="relative overflow-hidden rounded-[2rem] bg-ocean-950 p-7 text-white sm:p-9">
  <div class="absolute -right-24 -top-24 size-72 rounded-full bg-dawn-400/15 blur-3xl"></div>
  <div class="relative">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="section-kicker text-xs font-semibold text-dawn-300">今日觀景時間</p>
        <h3 class="mt-3 text-2xl font-semibold">今日晨光時間</h3>
      </div>
      <span class="grid size-12 place-items-center rounded-full border border-white/15 bg-white/10 text-dawn-300">
        <Icon name="sun" class="size-6" />
      </span>
    </div>
    <p id="sun-date" class="mt-4 text-sm text-white/56">依南方澳座標計算中…</p>
    <div class="mt-7 grid grid-cols-3 gap-3">
      <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-4">
        <p class="text-xs text-white/50">民用曙光</p>
        <p id="civil-dawn" class="mt-2 text-2xl font-semibold tabular-nums">--:--</p>
      </div>
      <div class="rounded-2xl border border-dawn-300/30 bg-dawn-300/10 p-4">
        <p class="text-xs text-dawn-200">日出</p>
        <p id="sunrise" class="mt-2 text-2xl font-semibold tabular-nums text-dawn-200">--:--</p>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-4">
        <p class="text-xs text-white/50">建議抵達</p>
        <p id="arrival" class="mt-2 text-2xl font-semibold tabular-nums">--:--</p>
      </div>
    </div>
    <div class="mt-5 flex gap-3 rounded-2xl bg-white/[0.06] p-4 text-sm leading-6 text-white/66">
      <Icon name="info" class="mt-0.5 size-5 shrink-0 text-dawn-300" />
      <p>時間由瀏覽器依座標推算，不含當日雲量與海上能見度。拍攝日出建議比民用曙光再早約 10–15 分鐘到場。</p>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const LAT = 24.5765079;
    const LNG = 121.8667597;
    const TZ = 8;
    const rad = (value) => value * Math.PI / 180;
    const deg = (value) => value * 180 / Math.PI;
    const normalize = (value, max) => ((value % max) + max) % max;

    function dayOfYear(year, month, day) {
      const start = Date.UTC(year, 0, 0);
      const current = Date.UTC(year, month - 1, day);
      return Math.floor((current - start) / 86400000);
    }

    function solarTime(year, month, day, sunrise, zenith) {
      const n = dayOfYear(year, month, day);
      const lngHour = LNG / 15;
      const t = n + (((sunrise ? 6 : 18) - lngHour) / 24);
      const m = (0.9856 * t) - 3.289;
      let l = m + (1.916 * Math.sin(rad(m))) + (0.020 * Math.sin(rad(2 * m))) + 282.634;
      l = normalize(l, 360);
      let ra = deg(Math.atan(0.91764 * Math.tan(rad(l))));
      ra = normalize(ra, 360);
      const lQuadrant = Math.floor(l / 90) * 90;
      const raQuadrant = Math.floor(ra / 90) * 90;
      ra = (ra + lQuadrant - raQuadrant) / 15;
      const sinDec = 0.39782 * Math.sin(rad(l));
      const cosDec = Math.cos(Math.asin(sinDec));
      const cosH = (Math.cos(rad(zenith)) - (sinDec * Math.sin(rad(LAT)))) / (cosDec * Math.cos(rad(LAT)));
      if (cosH > 1 || cosH < -1) return null;
      let h = sunrise ? 360 - deg(Math.acos(cosH)) : deg(Math.acos(cosH));
      h /= 15;
      const localMeanTime = h + ra - (0.06571 * t) - 6.622;
      const utc = normalize(localMeanTime - lngHour, 24);
      return normalize(utc + TZ, 24);
    }

    function getTaipeiDate() {
      const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Asia/Taipei', year: 'numeric', month: '2-digit', day: '2-digit'
      }).formatToParts(new Date());
      const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));
      return { year: Number(values.year), month: Number(values.month), day: Number(values.day) };
    }

    function formatHour(value) {
      if (value == null) return '--:--';
      let hours = Math.floor(value);
      let minutes = Math.round((value - hours) * 60);
      if (minutes === 60) { hours = (hours + 1) % 24; minutes = 0; }
      return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
    }

    function subtractMinutes(value, minutes) {
      return value == null ? null : normalize(value - minutes / 60, 24);
    }

    const date = getTaipeiDate();
    const dawn = solarTime(date.year, date.month, date.day, true, 96);
    const rise = solarTime(date.year, date.month, date.day, true, 90.833);
    const arrival = subtractMinutes(dawn, 12);
    const dateLabel = document.getElementById('sun-date');
    const dawnLabel = document.getElementById('civil-dawn');
    const riseLabel = document.getElementById('sunrise');
    const arrivalLabel = document.getElementById('arrival');
    if (dateLabel) dateLabel.textContent = `${date.year} 年 ${date.month} 月 ${date.day} 日・台灣時間`;
    if (dawnLabel) dawnLabel.textContent = formatHour(dawn);
    if (riseLabel) riseLabel.textContent = formatHour(rise);
    if (arrivalLabel) arrivalLabel.textContent = formatHour(arrival);
  })();
</script>
